#!/bin/sh
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    MACHINE_ID=$(cat /var/lib/dbus/machine-id 2>/dev/null)
    DISPLAY_NUM=${DISPLAY#:}
    DISPLAY_NUM=${DISPLAY_NUM%%.*}
    AUTOLAUNCH_FILE="$HOME/.dbus/session-bus/${MACHINE_ID}-${DISPLAY_NUM}"
    if [ -f "$AUTOLAUNCH_FILE" ]; then
        . "$AUTOLAUNCH_FILE"
        export DBUS_SESSION_BUS_ADDRESS
    fi
fi
# Force the dark GTK variant so Chromium's GTK-based UI (menus, dialogs,
# download popups, etc.) follows the dark theme even on niri.
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"

# Mark the last session as cleanly-exited so the "Restore pages?" bubble
# doesn't appear. Tabs still restore via "Continue where you left off".
if ! pgrep -x chromium >/dev/null 2>&1 && [ -f "$HOME/.config/chromium/Default/Preferences" ]; then
    sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/' "$HOME/.config/chromium/Default/Preferences"
fi

exec /usr/bin/chromium --restore-last-session --hide-crash-restore-bubble "$@"
