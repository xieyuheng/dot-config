#!/usr/bin/env sh

if [ -r "$HOME/.config/path.list" ]; then
    NEW_PATH=""
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'*) continue ;;
        esac
        case "$line" in
            '~'*) line="$HOME${line#\~}" ;;
        esac
        NEW_PATH="${NEW_PATH:+$NEW_PATH:}$line"
    done < "$HOME/.config/path.list"
    [ -n "$NEW_PATH" ] && export PATH="$NEW_PATH"
fi

exec dbus-run-session -- niri
